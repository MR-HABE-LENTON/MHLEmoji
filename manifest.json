{
  "manifest_version": 3,
  "name": "Instagram Emoji Switcher",
  "version": "3.0",
  "description": "تعديل حزمة وحجم إيموجيات إنستغرام بواجهة نيونية",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.instagram.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["samsung-emojis/*.png"],
      "matches": ["*://*.instagram.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}